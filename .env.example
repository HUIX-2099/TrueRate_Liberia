# Copy to `.env.local` and fill in. Never commit `.env.local`.

# Supabase (Auth + client API routes: prices, exchange_rates, etc.)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only: cron `/api/cron/refresh-rates` writes to `exchange_rates` (never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=

# Vercel Cron / scheduled jobs — Bearer or x-cron-secret (see `/api/digest/send`, `/api/cron/refresh-rates`)
CRON_SECRET=

# ExchangeRate-API v6 — USD/LRD live + history (`/api/rates`, `live-supabase`)
# Optional: use `demo` or leave unset for fallback sources
EXCHANGE_RATE_API_KEY=

# NewsAPI.org — optional (`/api/news` if you add a NewsAPI route)
NEWS_API_KEY=

# Notion MCP / API experiments (optional)
NOTION_TOKEN=
NOTION_DATABASE_ID=

# Anthropic — `POST /api/notion`, `POST /api/trfn/analyze`
ANTHROPIC_API_KEY=
