# PostgreSQL (required)
DATABASE_URL=postgresql://user:password@localhost:5432/truerate

# Ministry of Commerce Liberia endpoints (configure for your environment)
# If not set, sync will log and skip the corresponding fetch.
MOC_COMMODITY_URL=https://api.example.gov.lr/commerce/commodity-prices
MOC_IMPORT_URL=https://api.example.gov.lr/commerce/import-statistics

# Optional: API key or Bearer token for MoC
MOC_API_KEY=

# Cron schedule (default: daily at 06:00 UTC). Leave empty to disable cron.
# Examples: "0 6 * * *" (daily 06:00), "0 */6 * * *" (every 6 hours)
CRON_SCHEDULE=0 6 * * *

# Retry: max attempts and base delay in ms
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_MS=2000

# Log level: debug | info | warn | error
LOG_LEVEL=info
